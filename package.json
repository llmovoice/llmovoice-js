{
  "name": "llmovoice-js",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source context orchestration runtime for realtime voice agents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llmovoice/llmovoice-js.git"
  },
  "homepage": "https://llmovoice.com",
  "bugs": {
    "url": "https://github.com/llmovoice/llmovoice-js/issues"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build:packages": "pnpm --filter @llmovoice/core build && pnpm --filter @llmovoice/runtime build && pnpm --filter @llmovoice/openai build && pnpm --filter @llmovoice/providers build && pnpm --filter @llmovoice/twilio build && pnpm --filter @llmovoice/react build && pnpm --filter @llmovoice/postgres build && pnpm --filter @llmovoice/supabase build && pnpm --filter @llmovoice/cloud build",
    "build": "pnpm build:packages && pnpm --filter @llmovoice/demo build",
    "dev": "pnpm build:packages && pnpm --filter @llmovoice/demo dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e/demo.spec.ts",
    "test:e2e:real": "LLMOVOICE_E2E_REAL=1 playwright test tests/e2e/real.spec.ts",
    "test:telephony": "vitest run packages/openai/src/sip-sideband.test.ts packages/openai/src/sip-runtime.test.ts packages/openai/src/adapters.test.ts packages/twilio/src/index.test.ts",
    "test:providers": "vitest run packages/providers/src/index.test.ts",
    "test:providers:real": "pnpm build:packages && node scripts/provider-smoke.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "security:audit": "pnpm audit --prod",
    "benchmark": "pnpm build:packages && node scripts/benchmark.mjs",
    "supabase:reset": "supabase db reset --local",
    "supabase:lint": "supabase db lint --local --level warning",
    "supabase:test": "supabase test db",
    "release:check": "node scripts/release.mjs check",
    "release:pack": "node scripts/release.mjs pack",
    "release:publish:dry-run": "node scripts/release.mjs publish --dry-run",
    "release:publish": "node scripts/release.mjs publish",
    "release:push": "node scripts/release.mjs push",
    "release": "node scripts/release.mjs release"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
