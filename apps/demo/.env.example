# Standard API keys are read only by the Next.js server.
OPENAI_API_KEY=

# Optional overrides.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_TIMEOUT_MS=4000

# Production E2E: the browser session, ContextStore, token endpoint, and
# embedding endpoint all use the same Supabase Auth identity.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Namespace for llmovoice-owned Pages, Threads, traces, and enrichment jobs.
# Keep the canonical table/function names from the matching migration.
NEXT_PUBLIC_LLMOVOICE_SCHEMA=llmovoice

# CoachGPT can share the same Supabase project. These defaults read active
# profile/goal/preference/safety-boundary rows through RLS.
NEXT_PUBLIC_COACHGPT_SCHEMA=coachgpt
NEXT_PUBLIC_COACHGPT_CONTEXT_TABLE=personal_context_items
# When embedded in CoachGPT, prefer its full authenticated state projection.
# NEXT_PUBLIC_COACHGPT_CONTEXT_ENDPOINT=/api/coaching/state

# Required for public production deployments. Enter the same value in the demo UI.
LLMOVOICE_DEMO_ACCESS_TOKEN=

# Credentialed Playwright run (never commit real values).
LLMOVOICE_E2E_EMAIL=
LLMOVOICE_E2E_PASSWORD=

# Optional Twilio Voice/SMS deployment. These are server-only values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=
PUBLIC_WEBHOOK_BASE_URL=

# Optional Mainland China provider smoke/integration values (server only).
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
GLM_API_KEY=
BAIDU_API_KEY=
MINIMAX_API_KEY=
ARK_API_KEY=
HUNYUAN_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# Cost and abuse controls.
DEMO_RATE_LIMIT_MAX=5
DEMO_RATE_LIMIT_WINDOW_MS=600000
OPENAI_REALTIME_TOKEN_TTL_SECONDS=120
OPENAI_REALTIME_TOKEN_TIMEOUT_MS=8000
OPENAI_REALTIME_MAX_INPUT_TOKENS=8000
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=1024
